# Copy to .env for running outside docker compose. Inside compose these are set
# in docker-compose.yml and this file is not read.
#
# Nothing here is a production value. The compose defaults are local-only
# credentials on purpose — see docs/ARCHITECTURE.md on secret handling.

THRESHOLD_ENVIRONMENT=local
THRESHOLD_LOG_LEVEL=INFO

# There is no single runtime identity. Since 0012 the API and the worker hold a
# role each -- see D-035 -- so this variable is whichever process you are about
# to start, and inside compose each service sets its own.
#
#   threshold_api     records what people decide; writes no evidence, updates nothing
#   threshold_worker  writes the record; cannot say a person approved anything
#
# Migrations, the seed and the test fixtures need the owner (threshold:threshold)
# and set it themselves. Nothing long-running should.
THRESHOLD_DATABASE_URL=postgresql+asyncpg://threshold_api:threshold_api@localhost:5432/threshold
# Read by migration 0012 when it creates those roles -- and, if set, applied to
# them on every later run. Set both before the first `alembic upgrade` anywhere
# that is not a laptop.
# THRESHOLD_API_DB_PASSWORD=
# THRESHOLD_WORKER_DB_PASSWORD=
THRESHOLD_S3_ENDPOINT_URL=http://localhost:9000
THRESHOLD_S3_ACCESS_KEY_ID=minioadmin
THRESHOLD_S3_SECRET_ACCESS_KEY=minioadmin
THRESHOLD_S3_BUCKET_DOCUMENTS=threshold-documents

THRESHOLD_OIDC_ISSUER=http://localhost:8080/realms/threshold
