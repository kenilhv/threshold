# Copy to .env for running outside docker compose. Inside compose these are set
# in docker-compose.yml and this file is not read.
#
# Nothing here is a production value. The compose defaults are local-only
# credentials on purpose — see docs/ARCHITECTURE.md on secret handling.

THRESHOLD_ENVIRONMENT=local
THRESHOLD_LOG_LEVEL=INFO

THRESHOLD_DATABASE_URL=postgresql+asyncpg://threshold:threshold@localhost:5432/threshold
THRESHOLD_REDIS_URL=redis://localhost:6379/0

THRESHOLD_S3_ENDPOINT_URL=http://localhost:9000
THRESHOLD_S3_ACCESS_KEY_ID=minioadmin
THRESHOLD_S3_SECRET_ACCESS_KEY=minioadmin
THRESHOLD_S3_BUCKET_DOCUMENTS=threshold-documents

THRESHOLD_OIDC_ISSUER=http://localhost:8080/realms/threshold
