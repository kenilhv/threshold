# Terraform's provider cache and state. The lock file is committed on purpose:
# it pins the provider version that `terraform validate` ran against, and a
# validation against an unpinned provider proves less each week.
infra/aws/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# Impeccable: review captures and per-machine config stay local.
.impeccable/review/
.impeccable/config.local.json
.impeccable/questions/
